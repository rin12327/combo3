-- 2. EXTREME VOID ENGINE (ONE-PASS CLEANUP & ANTILAG)
---------------------------------------------------------
local function nukeEverything()
    pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false) end)
    Lighting.Brightness = 0
    Lighting.ClockTime = 0
    Lighting.Ambient = Color3.new(0, 0, 0)
    Lighting.OutdoorAmbient = Color3.new(0, 0, 0)
    Lighting.GlobalShadows = false
    
    for _, obj in ipairs(Lighting:GetChildren()) do obj:Destroy() end
    for _, sound in ipairs(SoundService:GetDescendants()) do if sound:IsA("Sound") then sound:Destroy() end end

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") 
           or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Explosion") 
           or obj:IsA("Sparkles") or obj:IsA("Highlight") or obj:IsA("Decal") 
           or obj:IsA("Texture") or obj:IsA("Clouds") or obj:IsA("Sky") 
           or obj:IsA("PostEffect") or obj:IsA("Atmosphere") or obj:IsA("Sound") then
            obj:Destroy()
        elseif (obj:IsA("BasePart") or obj:IsA("MeshPart")) and not obj:IsDescendantOf(LocalPlayer.Character) and obj.Name ~= "HumanoidRootPart" then
            obj.Transparency = 1
            obj.CastShadow = false
            obj.Material = Enum.Material.SmoothPlastic
        end
    end
end

nukeEverything()

