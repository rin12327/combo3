-- 4. LOGIC ĐÁNH & CHIÊU (CỐ ĐỊNH CHUỘT GIẢ LẬP Ở TÂM MÀN HÌNH)
---------------------------------------------------------
local function performPunch()
    local vp = Workspace.CurrentCamera.ViewportSize
    
    local centerX = vp.X / 2
    local centerY = vp.Y / 2
    
    VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 0, true, game, 0)
    VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 0, false, game, 0)
end

local function castSkill3()
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Three, false, game)
    task.wait(0.05)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Three, false, game)
end

local function getValidAliveTarget()
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil end
    local myPos = myChar.HumanoidRootPart.Position
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local targetChar = plr.Character
            local hum = targetChar:FindFirstChildOfClass("Humanoid")
            local hrp = targetChar:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and hrp and not targetChar:FindFirstChildOfClass("ForceField") then
                if (hrp.Position - myPos).Magnitude <= 12 then return targetChar end
            end
        end
    end
    return nil
end

