-- 5. COMBO LOOP
---------------------------------------------------------
local autoPunchSkillEnabled = false
local autoPunchSkillThread = nil

AutoPunchSkillBtn.MouseButton1Click:Connect(function()
    autoPunchSkillEnabled = not autoPunchSkillEnabled
    AutoPunchSkillBtn.Text = autoPunchSkillEnabled and "🎯 Smart Skill 3: ON" or "🎯 Smart Skill 3: OFF"
    AutoPunchSkillBtn.BackgroundColor3 = autoPunchSkillEnabled and Color3.fromRGB(0, 180, 80) or Color3.fromRGB(180, 50, 50)
    
    if autoPunchSkillEnabled then
        autoPunchSkillThread = task.spawn(function()
            while autoPunchSkillEnabled do
                local target = getValidAliveTarget()
                if target then
                    performPunch()           
                    task.wait(0.6)           
                    castSkill3()             
                    task.wait(10)            
                else
                    task.wait(0.1)
                end
            end
        end)
    else
        if autoPunchSkillThread then task.cancel(autoPunchSkillThread) end
    end
end)

