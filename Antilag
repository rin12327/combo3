local function performPunch()
    local foundBtn = nil
    
    -- Quét tìm UI nút Punch/Attack
    for _, obj in pairs(PlayerGui:GetDescendants()) do
        if obj:IsA("GuiButton") and obj.Visible and (obj.Name:lower():find("attack") or obj.Name:lower():find("punch")) then
            foundBtn = obj
            break
        end
    end

    if foundBtn then
        local centerPosition = foundBtn.AbsolutePosition + (foundBtn.AbsoluteSize / 2)
        VirtualInputManager:SendMouseButtonEvent(centerPosition.X, centerPosition.Y, 0, true, game, 0)
        VirtualInputManager:SendMouseButtonEvent(centerPosition.X, centerPosition.Y, 0, false, game, 0)
    else
        -- Fallback Mobile: X=2.0, Y=2.0 (Hệ số 2.0)
        local vp = Workspace.CurrentCamera.ViewportSize
        local touchX = vp.X * 2.0
        local touchY = vp.Y * 2.0 
        
        VirtualInputManager:SendTouchEvent(0, Enum.UserInputState.Begin, touchX, touchY, game)
        VirtualInputManager:SendTouchEvent(0, Enum.UserInputState.End, touchX, touchY, game)
    end
end

local function castSkill3()
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Three, false, game)
    task.wait(0.05)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Three, false, game)
end

local function getValidAliveTarget()
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil end
    local myPos = myChar.HumanoidRootPart.Position
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local targetChar = plr.Character
            local hum = targetChar:FindFirstChildOfClass("Humanoid")
            local hrp = targetChar:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and hrp and not targetChar:FindFirstChildOfClass("ForceField") then
                if (hrp.Position - myPos).Magnitude <= 12 then return targetChar end
            end
        end
    end
    return nil
end

