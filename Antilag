-- 3. LOGIC FREEZE TỌA ĐỘ
---------------------------------------------------------
local targetCFrame1 = CFrame.new(439.18, 439.51, -375.31)
local isFrozen = false

FreezeBtn.MouseButton1Click:Connect(function()
    isFrozen = not isFrozen
    if isFrozen then
        FreezeBtn.Text = "🧊 Freeze Pos: ON"
        FreezeBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 80)
    else
        FreezeBtn.Text = "🧊 Freeze Pos: OFF"
        FreezeBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
    end
end)

RunService.RenderStepped:Connect(function()
    if isFrozen and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        LocalPlayer.Character.HumanoidRootPart.CFrame = targetCFrame1
        LocalPlayer.Character.HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero
    end
end)

LocalPlayer.CharacterAdded:Connect(function(newChar)
    local hum = newChar:WaitForChild("Humanoid", 5)
    if hum then 
        local anim = hum:FindFirstChildOfClass("Animator") 
        if anim then anim:Destroy() end 
    end
    
    if isFrozen then
        task.delay(0.5, function()
            if newChar:FindFirstChild("HumanoidRootPart") then 
                newChar.HumanoidRootPart.CFrame = targetCFrame1 
            end
        end)
    end
end)

---------------------------------------------------------
-- 4. LOGIC ĐÁNH & CHIÊU (SMART SKILL 3 - FIX MOBILE)
---------------------------------------------------------
local function pressKey(keyCode)
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
        task.wait(0.05)
        VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
    end)
end

local function spamKey(keyCode, duration)
    local startTime = tick()
    while tick() - startTime < duration do
        pressKey(keyCode)
        task.wait(0.05)
    end
end

-- Fix đấm cho Mobile: kích hoạt Tool/Activate hoặc dùng VirtualInputManager làm dự phòng
local function performPunch()
    pcall(function()
        local char = LocalPlayer.Character
        if char then
            local tool = char:FindFirstChildOfClass("Tool")
            if tool then
                tool:Activate()
            else
                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                task.wait(0.05)
                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
            end
        end
    end)
end

local function getValidAliveTarget()
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil end
    local myPos = myChar.HumanoidRootPart.Position

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local targetChar = plr.Character
            local hum = targetChar:FindFirstChildOfClass("Humanoid")
            local hrp = targetChar:FindFirstChild("HumanoidRootPart") or targetChar:FindFirstChild("Torso")
            
            if hum and hum.Health > 0 and hrp and not targetChar:FindFirstChildOfClass("ForceField") then
                if (hrp.Position - myPos).Magnitude <= 12 then
                    return targetChar
                end
            end
        end
    end
    return nil
end

---------------------------------------------------------
-- 5. CẤU HÌNH & LẮP VÒNG LẶP COMBO
---------------------------------------------------------
local HIT_TO_SKILL_DELAY = 0.6  -- Thời gian chờ giữa M1 và Chiêu 3
local COMBO_LOOP_DELAY = 10     -- Thời gian chờ sau khi xả chiêu để lặp lại

local autoPunchSkillEnabled = false
local autoPunchSkillThread = nil

local function startAutoPunchSkillLoop()
    autoPunchSkillThread = task.spawn(function()
        while autoPunchSkillEnabled do
            local target = getValidAliveTarget()
            if target then
                -- Thực hiện Combo
                performPunch()                    -- 1. Đấm M1 (Đã fix hỗ trợ Mobile)
                task.wait(HIT_TO_SKILL_DELAY)     -- 2. Chờ 0.6 giây
                
                spamKey(Enum.KeyCode.Three, 0.4)  -- 3. Xả Chiêu 3
                
                -- 4. Chờ 10 giây trước khi thực hiện lượt combo tiếp theo
                task.wait(COMBO_LOOP_DELAY)
            else
                task.wait(0.05)
            end
        end
    end)
end

AutoPunchSkillBtn.MouseButton1Click:Connect(function()
    autoPunchSkillEnabled = not autoPunchSkillEnabled
    if autoPunchSkillEnabled then
        AutoPunchSkillBtn.Text = "🎯 Smart Skill 3: ON"
        AutoPunchSkillBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 80)
        startAutoPunchSkillLoop()
    else
        AutoPunchSkillBtn.Text = "🎯 Smart Skill 3: OFF"
        AutoPunchSkillBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        if autoPunchSkillThread then
            task.cancel(autoPunchSkillThread)
            autoPunchSkillThread = nil
        end
    end
end)

